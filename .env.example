# Copy to .env and fill in secrets
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_this_with_a_secure_random_value
MONGO_URI=mongodb://127.0.0.1:27017/hearthandheal

# SMTP settings for real email sending (leave blank to use Ethereal test account in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@hearthandheal.org
